# Dockerfile — image obsidian-mcp (eddmann) avec bundles AUTONOMES.
#
# Pourquoi : le Dockerfile d'origine oublie les node_modules au runtime alors que
# ses bundles sont construits en --packages=external (dépendances NON inlinées)
# -> ERR_MODULE_NOT_FOUND. Copier le node_modules racine ne suffit pas non plus
# (workspaces npm : certaines deps comme 'diff' sont imbriquées dans
# packages/app/node_modules). Solution : rebundler SANS --packages=external,
# tout est inliné, aucun node_modules requis au runtime.
# Vérifié : le bundle démarre seul jusqu'à la validation des variables d'env.

FROM node:22.23.4-slim AS builder
WORKDIR /build
COPY . .
RUN npm ci --workspace @obsidian-mcp/app --include-workspace-root

# Bundles autonomes (http + stdio). Banner createRequire requis car des deps CJS
# utilisent require() dans la sortie ESM.
RUN cd packages/app && \
    ESBUILD=/build/node_modules/.bin/esbuild && \
    BANNER="import{createRequire}from'module';const require=createRequire(import.meta.url);" && \
    "$ESBUILD" src/server/local/http.ts  --bundle --platform=node --target=node22 --format=esm --tsconfig=tsconfig.json --banner:js="$BANNER" --outfile=/build/out/http/index.js && \
    "$ESBUILD" src/server/local/stdio.ts --bundle --platform=node --target=node22 --format=esm --tsconfig=tsconfig.json --banner:js="$BANNER" --outfile=/build/out/stdio/index.js

FROM node:22.23.4-slim
WORKDIR /app
RUN apt-get update \
 && apt-get install -y git ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Bundles autonomes uniquement — pas de node_modules.
COPY --from=builder /build/out/http/index.js  ./dist/http/index.js
COPY --from=builder /build/out/stdio/index.js ./dist/stdio/index.js

# Entrypoint : sélectionne stdio | http (compose passe "http")
RUN cat > /app/entrypoint.sh <<'EOF'
#!/bin/sh
set -e
MODE="${1:-stdio}"
case "$MODE" in
  stdio) echo "Starting Obsidian MCP Server in stdio mode..."; exec node dist/stdio/index.js ;;
  http)  echo "Starting Obsidian MCP Server in http mode...";  exec node dist/http/index.js ;;
  *) echo "Invalid mode: $MODE (use stdio|http)"; exit 1 ;;
esac
EOF
RUN chmod +x /app/entrypoint.sh

ENV NODE_ENV=production \
    NODE_OPTIONS="--no-warnings" \
    LOCAL_VAULT_PATH=/app/vault-local
RUN mkdir -p /app/vault-local

EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["http"]